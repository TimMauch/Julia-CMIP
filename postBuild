#!/bin/bash
# Runs once when mybinder.org builds the image (after Julia packages are installed and precompiled)
set -euo pipefail

# 1. Build the Python environment from CondaPkg.toml into the image
julia --project=. -e 'using CondaPkg; CondaPkg.resolve(); using PythonCall'

# 2. Load the heavy packages once so all precompile caches are part of the image
julia --project=. -e 'using CairoMakie, GeoMakie, Rasters, NCDatasets, BenchmarkTools'

# 3. Pre-download the CMIP data into ~/.esgf (same search as in the notebook),
#    so participants don't all download ~300 MB from ESGF at the same time.
#    If ESGF is unreachable during the build, continue: the notebook downloads it at runtime.
julia --project=. -e '
using PythonCall
intake_esgf = pyimport("intake_esgf")
catalog = intake_esgf.ESGFCatalog()
catalog.search(
    project       = "CMIP6",
    experiment_id = pylist(["historical", "ssp585"]),
    source_id     = "ACCESS-CM2",
    variable_id   = "tas",
    frequency     = "mon",
    variant_label = "r1i1p1f1",
    file_end      = "2100-12",
)
catalog.to_path_dict()
' || echo "WARNING: CMIP data pre-download failed, data will be downloaded when the notebook runs"
